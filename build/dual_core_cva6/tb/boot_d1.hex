// boot_d1.hex - Spinlock contention (LR/SC + counter increment)
// Hart 0 e Hart 1 disputam lock em 0x80002040 e incrementam
// counter em 0x80002000. Hart 1 verifica counter == 2 ao fim.
//
// 80000000  00002397  auipc t2, 2          # t2 = 0x80002000 (counter)
// 80000004  00010317  auipc t1, 0x10
// 80000008  F4C30313  addi t1, t1, -180    # t1 = 0x8000FF50 (tohost)
// 8000000C  04038413  addi s0, t2, 64      # s0 = 0x80002040 (lock)
// 80000010  F14022F3  csrr t0, mhartid
// 80000014  04029063  bnez t0, +64  -> 0x80000054
// 80000018  03200F13  addi t5, x0, 50      # short delay
// 8000001C  FFFF0F13  addi t5, t5, -1
// 80000020  FE0F1EE3  bnez t5, -4          # delay loop
// 80000024  10042FAF  lr.w t6, (s0)        # acquire: read lock
// 80000028  FE0F9EE3  bnez t6, -4          # if locked, retry lr
// 8000002C  00100E13  addi t3, x0, 1
// 80000030  19C422AF  sc.w t0, t3, (s0)    # try lock=1
// 80000034  FE0298E3  bnez t0, -16         # if SC failed, retry
// 80000038  00100E13  addi t3, x0, 1
// 8000003C  01C3AFAF  amoadd.w t6, t3, (t2)  # counter += 1, t6 = old
// 80000040  040F9A63  bnez t6, +84 -> FAIL (esperado old=0)
// 80000044  00042023  sw x0, 0(s0)         # release lock
// 80000048  00100E93  addi t4, x0, 1
// 8000004C  01D32023  sw t4, 0(t1)         # TOHOST
// 80000050  0000006F  jal x0, 0            # spin
// 80000054  12C00F13  addi t5, x0, 300     # long delay
// 80000058  FFFF0F13  addi t5, t5, -1
// 8000005C  FE0F1EE3  bnez t5, -4          # delay loop
// 80000060  10042FAF  lr.w t6, (s0)
// 80000064  FE0F9EE3  bnez t6, -4          # retry lr if locked
// 80000068  00100E13  addi t3, x0, 1
// 8000006C  19C422AF  sc.w t0, t3, (s0)
// 80000070  FE0298E3  bnez t0, -16         # retry if SC failed
// 80000074  00100E13  addi t3, x0, 1
// 80000078  01C3AFAF  amoadd.w t6, t3, (t2)  # counter += 1, t6 = old
// 8000007C  00100E93  addi t4, x0, 1       # expected old=1
// 80000080  01DF9A63  bne t6, t4, +20 -> FAIL (esperado old=1)
// 80000084  00042023  sw x0, 0(s0)         # release lock
// 80000088  00100E93  addi t4, x0, 1
// 8000008C  01D32023  sw t4, 0(t1)         # TOHOST
// 80000090  0000006F  jal x0, 0            # spin success
// 80000094  0000006F  jal x0, 0            # FAIL spin
//
