// B1+ - LR.W + SC.W (RISC-V A extension)
//
// Estende o B1 (so LR) para incluir SC.W (Store-Conditional Word).
// Verifica que:
//   1. Hart 0: SC escreve corretamente (t0=0 indica sucesso)
//   2. Hart 1: LR cross-tile le o valor que hart 0 escreveu via SC
//
// O nosso stub xsim sempre retorna sucesso para SC (nao rastreia reservation
// set real), entao o teste valida apenas o write-side e o cross-tile LR
// observando o resultado.
//
// Layout:
//   0x80002000  DATA (LR/SC target)
//   0x8000FF50  TOHOST
//
// Programa:
//   0x80000000  00002397  auipc t2, 2          ; t2 = 0x80002000
//   0x80000004  00010317  auipc t1, 0x10       ; t1 = 0x80010004
//   0x80000008  F4C30313  addi  t1, t1, -180   ; t1 = 0x8000FF50
//   0x8000000C  F14022F3  csrr  t0, mhartid
//   0x80000010  02029263  bnez  t0, +36        ; hart1 -> 0x80000034
//   // --- HART 0: LR + SC + verifica SC=0 ---
//   0x80000014  12300E13  addi  t3, x0, 0x123  ; value to store
//   0x80000018  1003AFAF  lr.w  t6, 0(t2)      ; LR (set reservation)
//   0x8000001C  19C3A2AF  sc.w  t0, t3, 0(t2)  ; SC: write t3, t0 = 0/1
//   0x80000020  02029C63  bnez  t0, +56        ; t0 != 0 -> 0x80000058 (fail)
//   0x80000024  00100E93  addi  t4, x0, 1
//   0x80000028  01D32023  sw    t4, 0(t1)      ; TOHOST = 1
//   0x8000002C  0000006F  jal   x0, 0          ; spin
//   0x80000030  0000006F  jal   x0, 0          ; padding
//   // --- HART 1: delay + LR cross-tile + verify ---
//   0x80000034  06400F13  addi  t5, x0, 100
//   0x80000038  FFFF0F13  addi  t5, t5, -1
//   0x8000003C  FE0F1EE3  bnez  t5, -4
//   0x80000040  1003AFAF  lr.w  t6, 0(t2)      ; LR (deve ver 0x123 escrito por hart0)
//   0x80000044  12300E13  addi  t3, x0, 0x123
//   0x80000048  01CF9863  bne   t6, t3, +16    ; mismatch -> 0x80000058
//   0x8000004C  00100E93  addi  t4, x0, 1
//   0x80000050  01D32023  sw    t4, 0(t1)      ; TOHOST = 1
//   0x80000054  0000006F  jal   x0, 0          ; spin success
//   0x80000058  0000006F  jal   x0, 0          ; spin fail
00002397
00010317
F4C30313
F14022F3
02029263
12300E13
1003AFAF
19C3A2AF
02029C63
00100E93
01D32023
