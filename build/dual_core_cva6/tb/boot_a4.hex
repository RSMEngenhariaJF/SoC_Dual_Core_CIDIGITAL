// boot_a4.hex - Migracao de linha de cache (ping-pong)
// Hart 0 escreve 0xAA na linha 0x80002000 tres vezes,
// Hart 1 escreve 0xBB tres vezes (intercaladas via delays).
// Hart 1 le valor final via AMOADD 0 (esperado 0xBB).
//
// 80000000  00002397  auipc t2, 2          # t2 = 0x80002000
// 80000004  00010317  auipc t1, 0x10
// 80000008  F4C30313  addi t1, t1, -180    # t1 = 0x8000FF50
// 8000000C  F14022F3  csrr t0, mhartid
// 80000010  04029263  bnez t0, +68  -> 0x80000054
// 80000014  0AA00E13  addi t3, x0, 0xAA    # value hart 0
// 80000018  01E00F13  addi t5, x0, 30      # delay
// 8000001C  FFFF0F13  addi t5, t5, -1
// 80000020  FE0F1EE3  bnez t5, -4
// 80000024  01C3A023  sw t3, 0(t2)         # 1a: line = 0xAA
// 80000028  03200F13  addi t5, x0, 50
// 8000002C  FFFF0F13  addi t5, t5, -1
// 80000030  FE0F1EE3  bnez t5, -4
// 80000034  01C3A023  sw t3, 0(t2)         # 2a: line = 0xAA
// 80000038  03200F13  addi t5, x0, 50
// 8000003C  FFFF0F13  addi t5, t5, -1
// 80000040  FE0F1EE3  bnez t5, -4
// 80000044  01C3A023  sw t3, 0(t2)         # 3a: line = 0xAA
// 80000048  00100E93  addi t4, x0, 1
// 8000004C  01D32023  sw t4, 0(t1)         # TOHOST
// 80000050  0000006F  jal x0, 0            # spin
// 80000054  0BB00E13  addi t3, x0, 0xBB    # value hart 1
// 80000058  03C00F13  addi t5, x0, 60      # delay
// 8000005C  FFFF0F13  addi t5, t5, -1
// 80000060  FE0F1EE3  bnez t5, -4
// 80000064  01C3A023  sw t3, 0(t2)         # 1a: line = 0xBB
// 80000068  03200F13  addi t5, x0, 50
// 8000006C  FFFF0F13  addi t5, t5, -1
// 80000070  FE0F1EE3  bnez t5, -4
// 80000074  01C3A023  sw t3, 0(t2)         # 2a: line = 0xBB
// 80000078  03200F13  addi t5, x0, 50
// 8000007C  FFFF0F13  addi t5, t5, -1
// 80000080  FE0F1EE3  bnez t5, -4
// 80000084  01C3A023  sw t3, 0(t2)         # 3a: line = 0xBB
// 80000088  06400F13  addi t5, x0, 100     # settle delay
// 8000008C  FFFF0F13  addi t5, t5, -1
// 80000090  FE0F1EE3  bnez t5, -4
// 80000094  0003AFAF  amoadd.w t6, x0, (t2) # le valor atual (AMO read-only)
// 80000098  0BB00E93  addi t4, x0, 0xBB    # expected
// 8000009C  01DF9863  bne t6, t4, +16 -> FAIL
// 800000A0  00100E93  addi t4, x0, 1
// 800000A4  01D32023  sw t4, 0(t1)         # TOHOST
// 800000A8  0000006F  jal x0, 0            # spin success
// 800000AC  0000006F  jal x0, 0            # FAIL spin
//
