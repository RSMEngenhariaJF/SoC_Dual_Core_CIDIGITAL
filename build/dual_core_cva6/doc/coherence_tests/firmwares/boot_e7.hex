// boot_e7.hex - M-extension (mul, div, rem)
// Hart 0: MUL 7*6==42
// Hart 1: DIV 100/7==14 e REM 100%%7==2
//
// 80000000  00010317  auipc t1, 0x10
// 80000004  F4C30313  addi t1, t1, -180    # t1 = 0x8000FF50 (tohost)
// 80000008  F14022F3  csrr t0, mhartid
// 8000000C  02029A63  bnez t0, +52 -> 0x80000040
// 80000010  00700293  addi t0, x0, 7       # operando A
// 80000014  00600313  addi t1, x0, 6       # operando B
// 80000018  02628E33  mul t3, t0, t1       # 7 * 6 = 42
// 8000001C  02A00E93  addi t4, x0, 42      # esperado
// 80000020  07DE1463  bne t3, t4, +104 -> FAIL
// 80000024  00010317  auipc t1, 0x10
// 80000028  F2C30313  addi t1, t1, -212  # t1 = 0x8000FF50
// 8000002C  00100E93  addi t4, x0, 1
// 80000030  01D32023  sw t4, 0(t1)         # TOHOST
// 80000034  0000006F  jal x0, 0            # spin success
// 80000038  0000006F  jal x0, 0  # padding
// 8000003C  0000006F  jal x0, 0  # padding
// 80000040  0C800F13  addi t5, x0, 200     # delay
// 80000044  FFFF0F13  addi t5, t5, -1
// 80000048  FE0F1EE3  bnez t5, -4          # delay loop
// 8000004C  06400293  addi t0, x0, 100     # dividendo
// 80000050  00700313  addi t1, x0, 7       # divisor
// 80000054  0262CE33  div t3, t0, t1       # 100 / 7 = 14
// 80000058  00E00E93  addi t4, x0, 14      # esperado
// 8000005C  03DE1663  bne t3, t4, +44 -> FAIL
// 80000060  0262EE33  rem t3, t0, t1       # 100 % 7 = 2
// 80000064  00200E93  addi t4, x0, 2       # esperado
// 80000068  03DE1063  bne t3, t4, +32 -> FAIL
// 8000006C  00010317  auipc t1, 0x10
// 80000070  EE430313  addi t1, t1, -284  # t1 = 0x8000FF50
// 80000074  00100E93  addi t4, x0, 1
// 80000078  01D32023  sw t4, 0(t1)         # TOHOST
// 8000007C  0000006F  jal x0, 0            # spin success
// 80000080  0000006F  jal x0, 0  # padding
// 80000084  0000006F  jal x0, 0  # padding
// 80000088  0000006F  jal x0, 0            # FAIL spin
//
