// boot_b2.hex - AMO suite (RISC-V A-extension)
// Hart 0 executa AMOSWAP, AMOADD, AMOXOR em 0x80002000 e valida
// cada retorno. Hart 1 (apos delay) le o resultado final = 0x2AA.
//
// 80000000  00002397  auipc t2, 2          # t2 = 0x80002000
// 80000004  00010317  auipc t1, 0x10
// 80000008  F4C30313  addi t1, t1, -180    # t1 = 0x8000FF50
// 8000000C  F14022F3  csrr t0, mhartid
// 80000010  04029463  bnez t0, +72  -> 0x80000058
// 80000014  10000E13  addi t3, x0, 0x100   # initial value
// 80000018  01C3A023  sw t3, 0(t2)         # mem = 0x100
// 8000001C  20000E13  addi t3, x0, 0x200   # swap operand
// 80000020  09C3AFAF  amoswap.w t6, t3, (t2)  # rd=mem, mem=t3
// 80000024  10000E93  addi t4, x0, 0x100   # expected old=0x100
// 80000028  05DF9A63  bne t6, t4, +84 -> FAIL (amoswap check)
// 8000002C  05500E13  addi t3, x0, 0x55    # add operand
// 80000030  01C3AFAF  amoadd.w t6, t3, (t2)   # rd=mem, mem+=t3
// 80000034  20000E93  addi t4, x0, 0x200   # expected old=0x200
// 80000038  05DF9263  bne t6, t4, +68 -> FAIL (amoadd check)
// 8000003C  0FF00E13  addi t3, x0, 0xFF    # xor operand
// 80000040  21C3AFAF  amoxor.w t6, t3, (t2)   # rd=mem, mem^=t3
// 80000044  25500E93  addi t4, x0, 0x255   # expected old=0x255
// 80000048  03DF9A63  bne t6, t4, +52 -> FAIL (amoxor check)
// 8000004C  00100E93  addi t4, x0, 1
// 80000050  01D32023  sw t4, 0(t1)         # TOHOST = 1
// 80000054  0000006F  jal x0, 0            # spin
// 80000058  1F400F13  addi t5, x0, 500     # delay long
// 8000005C  FFFF0F13  addi t5, t5, -1
// 80000060  FE0F1EE3  bnez t5, -4          # delay loop
// 80000064  0003AF83  lw t6, 0(t2)         # le mem (cross-tile)
// 80000068  2AA00E93  addi t4, x0, 0x2AA   # expected: 0x255 XOR 0xFF
// 8000006C  01DF9863  bne t6, t4, +16 -> FAIL (cross-tile check)
// 80000070  00100E93  addi t4, x0, 1
// 80000074  01D32023  sw t4, 0(t1)         # TOHOST = 1
// 80000078  0000006F  jal x0, 0            # spin
// 8000007C  0000006F  jal x0, 0            # FAIL spin
//
