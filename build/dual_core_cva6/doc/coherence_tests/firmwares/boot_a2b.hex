// A2b - Producer/Consumer SEM FENCE (variante de A2)
// Com shadow_mem garantindo dado correto, fence rw,rw nao e necessario.
// Investiga se o FENCE e o que esta travando o load_unit no xsim.
//
//   0x80000000  00002397  auipc t2, 2          ; t2 = 0x80002000
//   0x80000004  00010317  auipc t1, 0x10       ; t1 = 0x80010004
//   0x80000008  F4C30313  addi  t1, t1, -180   ; t1 = 0x8000FF50
//   0x8000000C  F14022F3  csrr  t0, mhartid
//   0x80000010  02029063  bnez  t0, +32        ; hart1 -> 0x80000030
//   // --- HART 0 (producer, SEM FENCE) ---
//   0x80000014  12300E13  addi  t3, x0, 0x123
//   0x80000018  01C3A023  sw    t3, 0(t2)      ; DATA = 0x123
//   0x8000001C  00100E93  addi  t4, x0, 1
//   0x80000020  05D3A023  sw    t4, 64(t2)     ; FLAG = 1
//   0x80000024  01D32023  sw    t4, 0(t1)      ; TOHOST = 1
//   0x80000028  0000006F  jal   x0, 0          ; spin
//   0x8000002C  0000006F  jal   x0, 0          ; padding
//   // --- HART 1 (consumer, SEM FENCE) ---
//   0x80000030  0403AF03  lw    t5, 64(t2)     ; load FLAG
//   0x80000034  FE0F0EE3  beqz  t5, -4         ; loop ate FLAG != 0
//   0x80000038  0003AF83  lw    t6, 0(t2)      ; load DATA (sem fence intermediario)
//   0x8000003C  12300E13  addi  t3, x0, 0x123
//   0x80000040  01CF9863  bne   t6, t3, +16    ; -> 0x80000050 (fail)
//   0x80000044  00100E93  addi  t4, x0, 1
//   0x80000048  01D32023  sw    t4, 0(t1)      ; TOHOST = 1
//   0x8000004C  0000006F  jal   x0, 0          ; spin success
//   0x80000050  0000006F  jal   x0, 0          ; spin fail
00002397
00010317
F4C30313
