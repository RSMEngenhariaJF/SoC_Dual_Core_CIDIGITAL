// A3 - Read-After-Write cross-tile (sem polling)
//
// Substitui o polling de A2 (que crasha xsim por back-to-back LWs) por
// busy-wait aritmetico em ambos os harts. Hart1 faz um UNICO LW depois
// que hart0 ja escreveu, demonstrando data sharing cross-tile sem
// estressar o caminho de LW repetido.
//
// Timeline esperado:
//   ciclo 0-N: setup comum, divergencia mhartid
//   ciclo ~5..300:  hart0 busy-wait (100 iter)
//   ciclo ~300:     hart0 escreve DATA = 0x123 em 0x80002000
//   ciclo ~305:     hart0 escreve TOHOST = 1
//   ciclo ~5..600:  hart1 busy-wait (200 iter, mais longo que hart0)
//   ciclo ~600:     hart1 le DATA (esperado: 0x123)
//   ciclo ~605:     hart1 verifica e escreve TOHOST = 1 se OK
//
// Layout:
//   0x80002000  DATA   (palavra compartilhada)
//   0x8000FF50  TOHOST
//
// Programa:
//   0x80000000  00002397  auipc t2, 2          ; t2 = 0x80002000 (DATA)
//   0x80000004  00010317  auipc t1, 0x10       ; t1 = 0x80010004
//   0x80000008  F4C30313  addi  t1, t1, -180   ; t1 = 0x8000FF50 (TOHOST)
//   0x8000000C  F14022F3  csrr  t0, mhartid    ; t0 = hart ID
//   0x80000010  02029263  bnez  t0, +36        ; hart1 -> 0x80000034
//   // --- HART 0 (producer, delay curto) ---
//   0x80000014  06400F13  addi  t5, x0, 100    ; delay counter
//   0x80000018  FFFF0F13  addi  t5, t5, -1
//   0x8000001C  FE0F1EE3  bnez  t5, -4         ; loop ate t5==0
//   0x80000020  12300E13  addi  t3, x0, 0x123  ; data magic
//   0x80000024  01C3A023  sw    t3, 0(t2)      ; DATA = 0x123
//   0x80000028  00100E93  addi  t4, x0, 1
//   0x8000002C  01D32023  sw    t4, 0(t1)      ; TOHOST = 1
//   0x80000030  0000006F  jal   x0, 0          ; spin
//   // --- HART 1 (consumer, delay longo + 1 LW) ---
//   0x80000034  0C800F13  addi  t5, x0, 200    ; delay counter (mais longo)
//   0x80000038  FFFF0F13  addi  t5, t5, -1
//   0x8000003C  FE0F1EE3  bnez  t5, -4         ; loop ate t5==0
//   0x80000040  0003AF83  lw    t6, 0(t2)      ; UNICO LW: le DATA
//   0x80000044  12300E13  addi  t3, x0, 0x123  ; magic esperado
//   0x80000048  01CF9863  bne   t6, t3, +16    ; se mismatch -> 0x80000058 (hang)
//   0x8000004C  00100E93  addi  t4, x0, 1
//   0x80000050  01D32023  sw    t4, 0(t1)      ; TOHOST = 1 (success)
//   0x80000054  0000006F  jal   x0, 0          ; spin
//   0x80000058  0000006F  jal   x0, 0          ; hang (data mismatch -> timeout)
